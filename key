-- Hàm tính toán Index duy nhất theo UserId và Ngày
local function GetDailyIndex()
    local player = game:GetService("Players").LocalPlayer
    local userId = player and player.UserId or 0
    local dateStr = os.date("!%Y-%m-%d") -- UTC Date
    
    local combinedStr = tostring(userId) .. "_" .. dateStr
    local hash = 0
    for i = 1, #combinedStr do
        local charCode = string.byte(combinedStr, i)
        hash = (hash * 31 + charCode) % 2147483647
    end
    
    return (hash % #KEYS_LIST) + 1
end

-- Lấy Key và Link tương ứng trong ngày
local function GetDailyData()
    local index = GetDailyIndex()
    return KEYS_LIST[index], LINKS_LIST[index]
end

