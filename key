--- XỬ LÝ LƯU KEY & SỰ KIỆN ---

local KEY_FILE_PATH = "BombHub_Key.txt"

local function SaveKey(key)
    pcall(function()
        if writefile then writefile(KEY_FILE_PATH, key) end
    end)
end

local function LoadSavedKey()
    local savedKey = ""
    pcall(function()
        if isfile and isfile(KEY_FILE_PATH) and readfile then
            savedKey = readfile(KEY_FILE_PATH)
        end
    end)
    return savedKey
end

