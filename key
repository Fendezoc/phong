    if savedKey and savedKey ~= "" then
        KeyInput.Text = savedKey
        SubmitBtn.Text = "ĐANG TỰ ĐỘNG KÍCH HOẠT..."
        task.wait(0.5)
        
        local success = VerifyAndExecute(savedKey)
        if not success then
